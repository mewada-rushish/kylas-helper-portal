    "config": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Receipt - {{settings.companyName}}</title>\n</head>\n<body style=\"margin: 0; padding: 0; background: #ffffff; color: #000; font-family: Helvetica, sans-serif;\">\n\n<div style=\"width: 100%; max-width: 794px; margin: 0 auto; background: #ffffff;\">\n\n  <!-- RECEIPT COPY 1 (CUSTOMER COPY - TOP HALF) -->\n  <div style=\"width: 100%; padding: 20px 40px;\">\n    \n    <!-- 1. HEADER SECTION -->\n    <table style=\"width: 100%; border-collapse: collapse;\">\n      <tr>\n        <td style=\"width: 1%; white-space: nowrap; vertical-align: middle; text-align: left; padding-right: 14px; border-right: 1px solid #000;\">\n          <img src=\"{{settings.logoUrl}}\" alt=\"Logo\" style=\"max-height: 58px; max-width: 130px;\" />\n        </td>\n        <td style=\"vertical-align: middle; text-align: left; padding-left: 14px;\">\n          <div style=\"font-size: 23px; font-weight: bold; color: #27347B; text-transform: uppercase;\">The Asmita's Club</div>\n          <div style=\"font-size: 11px; font-weight: bold; color: #000; text-transform: uppercase;\">Asmita Resorts Pvt. Ltd. <br><span style=\"font-weight: normal; line-height: 20px;\"><b>GSTIN:</b> {{settings.gstin}}</span></div>\n        </td>\n        <td style=\"width: 35%; vertical-align: middle; text-align: right; font-size: 10px; color: #000;\">\n          <div>{{settings.companyAddress}}</div>\n          <div style=\"height: 1px; background-color: #ccc; margin: 4px 0;\"></div>\n          <div style=\"font-size: 11px; font-weight: bold; color: #000;\">Contact: {{settings.contactNumber}}</div>\n        </td>\n      </tr>\n    </table>\n    \n    <div style=\"width: 100%; height: 3px; background-color: #27347B; margin-top: 4px; margin-bottom: 15px;\"></div>\n\n    <!-- Title Bar -->\n    <div style=\"background-color: #27347B; color: #ffffff; font-size: 12px; font-weight: bold; text-align: center; padding: 6px 0; margin-bottom: 15px;\">\n      RECEIPT DETAILS\n    </div>\n\n    <!-- Group 1: Meta Details (Bordered Grid) -->\n    <table style=\"width: 100%; border-collapse: collapse; border: 1px solid #000; font-size: 11px; color: #000; margin-bottom: 15px;\">\n      <tr>\n        <td style=\"padding: 6px 10px; border-bottom: 1px solid #000; border-right: 1px solid #000; width: 33%;\">\n          <strong style=\"color: #000;\">RECEIPT NO:</strong> {{invoice.id}}\n        </td>\n        <td style=\"padding: 6px 10px; border-bottom: 1px solid #000; border-right: 1px solid #000; width: 33%; text-align: center;\">\n          <strong style=\"color: #000;\">MEMBER ID:</strong> {{memberId}}\n        </td>\n        <td style=\"padding: 6px 10px; border-bottom: 1px solid #000; width: 34%; text-align: right;\">\n          <strong style=\"color: #000;\">Date:</strong> {{current.date}}\n        </td>\n      </tr>\n      <tr>\n        <td colspan=\"2\" style=\"padding: 6px 10px; border-bottom: 1px solid #000; border-right: 1px solid #000;\">\n          <strong style=\"color: #000;\">Received from Mr/Mrs.:</strong> {{customer.name}}\n        </td>\n        <td style=\"padding: 6px 10px; border-bottom: 1px solid #000; text-align: left;\">\n          <strong style=\"color: #000;\">Email:</strong> {{customer.email}}\n        </td>\n      </tr>\n      <tr>\n        <td colspan=\"3\" style=\"padding: 6px 10px; border-bottom: 1px solid #000;\">\n          <strong style=\"color: #000;\">Amount In Words:</strong> {{amount.words}}\n        </td>\n      </tr>\n      <tr>\n        <td colspan=\"3\" style=\"padding: 6px 10px; border-bottom: 1px solid #000;\">\n          <strong style=\"color: #000;\">Payment For:</strong> {{product.name}}\n        </td>\n      </tr>\n      {{#if payment.periodStart}}\n      <tr>\n        <td colspan=\"3\" style=\"padding: 6px 10px;\">\n          <strong style=\"color: #000;\">Start Date:</strong> {{payment.periodStart}} &nbsp;&nbsp;|&nbsp;&nbsp; <strong style=\"color: #000;\">End Date:</strong> {{payment.periodEnd}}\n        </td>\n      </tr>\n      {{/if}}\n    </table>\n\n    <!-- 3. PAYMENT INFO & BILLING SPLIT -->\n    <table style=\"width: 100%; border-collapse: collapse; border: 1px solid #000; font-size: 11px; color: #000;\">\n      <tr>\n        <!-- Left Pane: Payment Information -->\n        <td style=\"width: 50%; vertical-align: top; padding: 0; border-right: 1px solid #000;\">\n          <table style=\"width: 100%; border-collapse: collapse;\">\n            <tr>\n              <td colspan=\"2\" style=\"background-color: #F8F8FB; padding: 6px 10px; font-weight: bold; font-size: 10px; color: #27347B; border-bottom: 1px solid #000;\">\n                PAYMENT INFORMATION\n              </td>\n            </tr>\n            <tr>\n              <td style=\"padding: 6px 10px; color: #000; font-weight: bold; width: 40%;\">Paid By</td>\n              <td style=\"padding: 6px 10px;\">: {{payment.method}}</td>\n            </tr>\n            <tr>\n              <td style=\"padding: 6px 10px; color: #000; font-weight: bold;\">Dated</td>\n              <td style=\"padding: 6px 10px;\">: {{payment.date}}</td>\n            </tr>\n          </table>\n        </td>\n\n        <!-- Right Pane: Billing Breakdown -->\n        <td style=\"width: 50%; vertical-align: top; padding: 0;\">\n          <table style=\"width: 100%; border-collapse: collapse;\">\n            <tr>\n              <td colspan=\"2\" style=\"background-color: #F8F8FB; padding: 6px 10px; font-weight: bold; font-size: 10px; color: #27347B; border-bottom: 1px solid #000;\">\n                BILLING BREAKDOWN\n              </td>\n            </tr>\n            <tr>\n              <td style=\"padding: 4px 10px; font-weight: bold; font-size: 11px; color: #000;\">Basic</td>\n              <td style=\"padding: 4px 10px; text-align: right; font-size: 11px; color: #000;\">{{invoice.subtotal}}</td>\n            </tr>\n            <tr>\n              <td style=\"padding: 4px 10px; font-weight: bold; font-size: 11px; color: #000;\">CGST @ 9%</td>\n              <td style=\"padding: 4px 10px; text-align: right; font-size: 11px; color: #000;\">{{invoice.cgst}}</td>\n            </tr>\n            <tr>\n              <td style=\"padding: 4px 10px; font-weight: bold; font-size: 11px; color: #000;\">SGST @ 9%</td>\n              <td style=\"padding: 4px 10px; text-align: right; font-size: 11px; color: #000;\">{{invoice.sgst}}</td>\n            </tr>\n            <tr>\n              <td style=\"padding: 7px 10px; font-weight: bold; font-size: 12px; color: #27347B; border-top: 1px solid #000;\">Total Amount</td>\n              <td style=\"padding: 7px 10px; text-align: right; font-weight: bold; font-size: 13px; color: #27347B; border-top: 1px solid #000;\">{{invoice.total}}</td>\n            </tr>\n          </table>\n        </td>\n      </tr>\n    </table>\n\n    <!-- 4. FOOTER AREA -->\n    <table style=\"width: 100%; border-collapse: collapse; margin-top: 15px;\">\n      <tr>\n        <td style=\"width: 70%; vertical-align: bottom;\">\n          <div style=\"font-size: 10px; font-weight: bold; color: #000; margin-bottom: 8px;\">\n            User Name: <span style=\"font-weight: normal;\">{{customer.name}}</span>\n          </div>\n          <div style=\"font-size: 9px; line-height: 1.4; color: #000;\">\n            Receipts are subject to realisation of cheque. The receipt is further subject to TERMS & CONDITIONS.<br>\n            Payment Once Made is not REFUNDABLE, TRANSFERABLE & EXTENDABLE.\n          </div>\n        </td>\n        <td style=\"width: 30%; vertical-align: bottom; text-align: center;\">\n          <div style=\"text-align: center; width: 80%; margin: 0 auto;\">\n            {{#if settings.signatureUrl}}\n              <img src=\"{{settings.signatureUrl}}\" style=\"max-height: 40px; margin-bottom: 5px;\" />\n            {{else}}\n              <div style=\"height: 40px;\"></div>\n            {{/if}}\n            <div style=\"border-top: 1px solid #000; font-size: 10px; font-weight: bold; color: #000; padding-top: 4px;\">\n              Authorized Signatory\n            </div>\n          </div>\n        </td>\n      </tr>\n    </table>\n  </div>\n\n  <!-- CUT LINE -->\n  <div style=\"width: 100%; text-align: right; font-size: 11px; margin-top: 10px;\"><svg style=\"width: 12px; height: 12px; vertical-align: middle; display: inline-block; margin-right: 2px; color: #000;\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"6\" cy=\"6\" r=\"3\"></circle><circle cx=\"6\" cy=\"18\" r=\"3\"></circle><line x1=\"20\" y1=\"4\" x2=\"8.12\" y2=\"15.88\"></line><line x1=\"14.47\" y1=\"14.48\" x2=\"20\" y2=\"20\"></line><line x1=\"8.12\" y1=\"8.12\" x2=\"12\" y2=\"12\"></line></svg> Cut Here</div>\n  <div style=\"border-top: 1px dashed #000; width: 100%; margin: 5px 0 15px 0;\"></div>\n\n  <!-- RECEIPT COPY 2 (INTERNAL COPY - BOTTOM HALF) -->\n  <div style=\"width: 100%; padding: 20px 40px;\">\n    \n    <!-- Header with Logo -->\n    <table style=\"width: 100%; border-collapse: collapse;\">\n      <tr>\n        <td style=\"width: 1%; white-space: nowrap; vertical-align: middle; text-align: left; padding-right: 14px; border-right: 1px solid #000;\">\n          <img src=\"{{settings.logoUrl}}\" alt=\"Logo\" style=\"max-height: 58px; max-width: 130px;\" />\n        </td>\n        <td style=\"vertical-align: middle; text-align: left; padding-left: 14px;\">\n          <div style=\"font-size: 23px; font-weight: bold; color: #27347B; text-transform: uppercase;\">The Asmita's Club</div>\n          <div style=\"font-size: 11px; font-weight: bold; color: #000; text-transform: uppercase;\">Asmita Resorts Pvt. Ltd. <span style=\"font-weight: normal; margin-left: 4px;\">| GSTIN: {{settings.gstin}}</span></div>\n        </td>\n        <td style=\"width: 35%; vertical-align: middle; text-align: right; font-size: 10px; color: #000;\">\n          <div>{{settings.companyAddress}}</div>\n          <div style=\"height: 1px; background-color: #ccc; margin: 4px 0;\"></div>\n          <div style=\"font-size: 11px; font-weight: bold; color: #000;\">Contact: {{settings.contactNumber}}</div>\n        </td>\n      </tr>\n    </table>\n    \n    <div style=\"width: 100%; height: 3px; background-color: #27347B; margin-top: 4px; margin-bottom: 15px;\"></div>\n\n    <!-- Title Bar -->\n    <div style=\"background-color: #27347B; color: #ffffff; font-size: 12px; font-weight: bold; text-align: center; padding: 6px 0; margin-bottom: 15px;\">\n      RECEIPT DETAILS\n    </div>\n\n    <!-- Group 1: Meta Details (Bordered Grid) -->\n    <table style=\"width: 100%; border-collapse: collapse; border: 1px solid #000; font-size: 11px; color: #000; margin-bottom: 15px;\">\n      <tr>\n        <td style=\"padding: 6px 10px; border-bottom: 1px solid #000; border-right: 1px solid #000; width: 33%;\">\n          <strong style=\"color: #000;\">RECEIPT NO:</strong> {{invoice.id}}\n        </td>\n        <td style=\"padding: 6px 10px; border-bottom: 1px solid #000; border-right: 1px solid #000; width: 33%; text-align: center;\">\n          <strong style=\"color: #000;\">MEMBER ID:</strong> {{memberId}}\n        </td>\n        <td style=\"padding: 6px 10px; border-bottom: 1px solid #000; width: 34%; text-align: right;\">\n          <strong style=\"color: #000;\">Date:</strong> {{current.date}}\n        </td>\n      </tr>\n      <tr>\n        <td colspan=\"2\" style=\"padding: 6px 10px; border-bottom: 1px solid #000; border-right: 1px solid #000;\">\n          <strong style=\"color: #000;\">Received from Mr/Mrs.:</strong> {{customer.name}}\n        </td>\n        <td style=\"padding: 6px 10px; border-bottom: 1px solid #000; text-align: left;\">\n          <strong style=\"color: #000;\">Email:</strong> {{customer.email}}\n        </td>\n      </tr>\n      <tr>\n        <td colspan=\"3\" style=\"padding: 6px 10px; border-bottom: 1px solid #000;\">\n          <strong style=\"color: #000;\">Amount In Words:</strong> {{amount.words}}\n        </td>\n      </tr>\n      <tr>\n        <td colspan=\"3\" style=\"padding: 6px 10px; border-bottom: 1px solid #000;\">\n          <strong style=\"color: #000;\">Payment For:</strong> {{product.name}}\n        </td>\n      </tr>\n      {{#if payment.periodStart}}\n      <tr>\n        <td colspan=\"3\" style=\"padding: 6px 10px;\">\n          <strong style=\"color: #000;\">Start Date:</strong> {{payment.periodStart}} &nbsp;&nbsp;|&nbsp;&nbsp; <strong style=\"color: #000;\">End Date:</strong> {{payment.periodEnd}}\n        </td>\n      </tr>\n      {{/if}}\n    </table>\n\n    <!-- Group 2: Payment Info & Billing Breakdown (Bordered Split) -->\n    <table style=\"width: 100%; border-collapse: collapse; border: 1px solid #000; font-size: 11px; color: #000;\">\n      <tr>\n        <!-- Left Pane: Payment Information -->\n        <td style=\"width: 50%; vertical-align: top; padding: 0; border-right: 1px solid #000;\">\n          <table style=\"width: 100%; border-collapse: collapse;\">\n            <tr>\n              <td colspan=\"2\" style=\"background-color: #F8F8FB; padding: 6px 10px; font-weight: bold; font-size: 10px; color: #27347B; border-bottom: 1px solid #000;\">\n                PAYMENT INFORMATION\n              </td>\n            </tr>\n            <tr>\n              <td style=\"padding: 6px 10px; color: #000; font-weight: bold; width: 40%;\">Paid By</td>\n              <td style=\"padding: 6px 10px;\">: {{payment.method}}</td>\n            </tr>\n            <tr>\n              <td style=\"padding: 6px 10px; color: #000; font-weight: bold;\">Dated</td>\n              <td style=\"padding: 6px 10px;\">: {{payment.date}}</td>\n            </tr>\n          </table>\n        </td>\n\n        <!-- Right Pane: Billing Breakdown -->\n        <td style=\"width: 50%; vertical-align: top; padding: 0;\">\n          <table style=\"width: 100%; border-collapse: collapse;\">\n            <tr>\n              <td colspan=\"2\" style=\"background-color: #F8F8FB; padding: 6px 10px; font-weight: bold; font-size: 10px; color: #27347B; border-bottom: 1px solid #000;\">\n                BILLING BREAKDOWN\n              </td>\n            </tr>\n            <tr>\n              <td style=\"padding: 4px 10px; font-weight: bold; font-size: 11px; color: #000;\">Basic</td>\n              <td style=\"padding: 4px 10px; text-align: right; font-size: 11px; color: #000;\">{{invoice.subtotal}}</td>\n            </tr>\n            <tr>\n              <td style=\"padding: 4px 10px; font-weight: bold; font-size: 11px; color: #000;\">CGST @ 9%</td>\n              <td style=\"padding: 4px 10px; text-align: right; font-size: 11px; color: #000;\">{{invoice.cgst}}</td>\n            </tr>\n            <tr>\n              <td style=\"padding: 4px 10px; font-weight: bold; font-size: 11px; color: #000;\">SGST @ 9%</td>\n              <td style=\"padding: 4px 10px; text-align: right; font-size: 11px; color: #000;\">{{invoice.sgst}}</td>\n            </tr>\n            <tr>\n              <td style=\"padding: 7px 10px; font-weight: bold; font-size: 12px; color: #27347B; border-top: 1px solid #000;\">Total Amount</td>\n              <td style=\"padding: 7px 10px; text-align: right; font-weight: bold; font-size: 13px; color: #27347B; border-top: 1px solid #000;\">{{invoice.total}}</td>\n            </tr>\n          </table>\n        </td>\n      </tr>\n    </table>\n\n    <!-- Footer Area -->\n    <table style=\"width: 100%; border-collapse: collapse; margin-top: 15px;\">\n      <tr>\n        <td style=\"width: 70%; vertical-align: bottom;\">\n          <div style=\"font-size: 10px; font-weight: bold; color: #000; margin-bottom: 8px;\">\n            User Name: <span style=\"font-weight: normal;\">{{customer.name}}</span>\n          </div>\n          <div style=\"font-size: 9px; line-height: 1.4; color: #000;\">\n            Receipts are subject to realisation of cheque. The receipt is further subject to TERMS & CONDITIONS.<br>\n            Payment Once Made is not REFUNDABLE, TRANSFERABLE & EXTENDABLE.\n          </div>\n        </td>\n        <td style=\"width: 30%; vertical-align: bottom; text-align: center;\">\n          <div style=\"text-align: center; width: 80%; margin: 0 auto;\">\n            {{#if settings.signatureUrl}}\n              <img src=\"{{settings.signatureUrl}}\" style=\"max-height: 40px; margin-bottom: 5px;\" />\n            {{else}}\n              <div style=\"height: 40px;\"></div>\n            {{/if}}\n            <div style=\"border-top: 1px solid #000; font-size: 10px; font-weight: bold; color: #000; padding-top: 4px;\">\n              Authorized Signatory\n            </div>\n          </div>\n        </td>\n      </tr>\n    </table>\n  </div>\n</div>\n\n</body>\n</html>",
