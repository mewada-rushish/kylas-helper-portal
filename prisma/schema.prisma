datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique @db.VarChar(255)
  password           String    @db.VarChar(255)
  role               String    @default("META_MARKETING") @db.VarChar(50)
  customAccess       String?   @db.Text
  resetToken         String?   @db.VarChar(255)
  resetTokenExpiry   DateTime?
  passwordChangedAt  DateTime?
  createdAt          DateTime  @default(now())
}

model WorkflowRule {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(255)
  trigger     String   @db.VarChar(100)
  status      String   @default("draft") @db.VarChar(50)
  nodesCount  Int      @default(0)
  config      String?  @db.Text         
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SyncLog {
  id           String    @id @default(cuid())
  leadId       String    @unique @db.VarChar(100)
  status       String    @default("QUEUED") @db.VarChar(50) // QUEUED, PROCESSING, SUCCESS, FAILED
  payload      String    @db.Text                 
  attempts     Int       @default(0)
  errorMessage String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model InvoiceTemplate {
  id                String   @id @default(cuid())
  name              String   @db.VarChar(255)
  isDefault         Boolean  @default(false)
  attachedProductId String?  @db.VarChar(100)
  config            String   @db.Text                 
  theme             String?  @db.Text
  createdAt         DateTime @default(now())
}

model Invoice {
  id        String   @id @default(cuid())
  customer  String   @db.VarChar(255)
  email     String   @db.VarChar(255)
  date      DateTime
  productId String   @db.VarChar(100)
  qty       Int
  rate      Float
  total     Float
  createdAt DateTime @default(now())
}

model SystemSetting {
  id                  String   @id @default("default")
  companyName         String   @default("AsmitA Enterprise Studio") @db.VarChar(255)
  authorizedSignatory String   @default("Authorized Signatory Label") @db.VarChar(255)
  companyAddress      String   @default("401-403, Deep Navy Business Park, Mira Bhayandar, Maharashtra, 401107") @db.Text
  invoicePrefixBase   String   @default("INV") @db.VarChar(50)
  paddingDigits       String   @default("4") @db.VarChar(10)
  nextSequence        Int      @default(1001)
  globalCurrency      String   @default("INR") @db.VarChar(10)
  dateFormat          String   @default("YYYY-MM-DD") @db.VarChar(50)
  gstin               String   @default("27AAAAA0000A1Z5") @db.VarChar(50)
  panCode             String   @default("ABCDE1234F") @db.VarChar(50)
  bankDetails         String   @default("HDFC Bank, A/C: 50200012345678, IFSC: HDFC0000123") @db.Text
  retryLimit          String   @default("3") @db.VarChar(10)
  timeoutBound        String   @default("5000") @db.VarChar(50)
  alertEmail          String   @default("devops@asmita.society.io") @db.VarChar(255)
  logoUrl             String?  @db.Text
  logRetentionDays    String   @default("0") @db.VarChar(10) // "0" means infinite
  templatePageSize    String   @default("A4") @db.VarChar(50)
  templateOrientation String   @default("portrait") @db.VarChar(50)
  templateMargin      Int      @default(24)
  templateNullStrategy String  @default("fallback") @db.VarChar(50)
  webhookMappings     String?  @db.Text
  updatedAt           DateTime @updatedAt
}

model Webhook {
  id                String   @id @default(cuid())
  name              String   @db.VarChar(255)
  triggerType       String   @db.VarChar(100)
  category          String   @db.VarChar(50)
  method            String   @db.VarChar(10)
  url               String   @db.Text
  isActive          Boolean  @default(true)
  headers           String?  @db.Text
  queryParams       String?  @db.Text
  bodyPayload       String?  @db.Text
  selectedVariables String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model IncomingWebhookConfig {
  id                String   @id @default(cuid())
  name              String   @default("Incoming Webhook") @db.VarChar(255)
  provider          String   // e.g., "KYLAS", "CUSTOM"
  endpointPath      String   @unique // e.g., "/api/webhooks/incoming/..."
  authType          String   @default("NO_AUTH") // NO_AUTH, BEARER_TOKEN, BASIC_AUTH
  authToken         String?  @db.VarChar(255)
  isActive          Boolean  @default(true)
  isTestMode        Boolean  @default(false)
  selectedVariables String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model WebhookLog {
  id        String   @id @default(cuid())
  webhookId String   @default("legacy_kylas") // ID of the IncomingWebhookConfig
  payload   String   @db.Text
  createdAt DateTime @default(now())
}

model SystemLog {
  id        String   @id @default(cuid())
  source    String   @db.VarChar(100)
  severity  String   @default("info") @db.VarChar(20)
  message   String   @db.Text
  details   String?  @db.Text
  createdAt DateTime @default(now())
}